{
  "name": "nolquiz-story-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:catalog": "node scripts/generate-story-assets.mjs",
    "assets:prepare": "node scripts/prepare-story-assets.mjs",
    "assets:audit": "node scripts/audit-character-assets.mjs",
    "template:generate": "node scripts/generate-story-template.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern '**/._*'",
    "check": "npm run lint && tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "brace-expansion": "1.1.18",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "wrangler": "4.128.0"
  },
  "type": "module",
  "overrides": {
    "uuid": "11.1.1",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
